# Which LLM writes the answers: ollama (free, local) | openai (any OpenAI-compatible API, e.g. Groq) | anthropic | none
LLM_PROVIDER=ollama

# Ollama (default)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI-compatible API. Defaults point at Groq's free tier: get a key at https://console.groq.com
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# Claude (paid). Uses ANTHROPIC_API_KEY or an `ant auth login` profile.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Retrieval
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=Xenova/ms-marco-MiniLM-L-12-v2
TOP_K=6
